# Copy to .env. Everything here is free and open source; no API keys required.

# ollama | openai_compatible | offline
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b            # or qwen2.5:7b, mistral-nemo, llama3.2:3b (smaller/faster)
JUDGE_MODEL=                      # optional separate model for LLM-as-judge evaluation
EMBEDDING_PROVIDER=ollama         # ollama | openai_compatible | hashing
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Any self-hosted OpenAI-compatible server (vLLM, LM Studio, llama.cpp server, LocalAI)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8001/v1
OPENAI_COMPATIBLE_API_KEY=not-needed

# Qdrant: leave QDRANT_URL empty to use embedded on-disk mode (no server needed)
QDRANT_URL=
COLLECTION_NAME=knowledge_base

TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_CONTEXT_TOKENS=2500
MAX_AGENT_STEPS=4
ENABLE_GUARDRAILS=true
MIN_GROUNDEDNESS=0.35

# Optional self-hosted Langfuse (MIT) for prompt/completion tracing
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
